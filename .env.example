# Copy to .env and adjust. Skyfall does NOT load .env automatically:
# export the variables in your shell (source .env) or use systemd EnvironmentFile=.

# ---------- Mode ----------
# 0 = global Raw Mode (skip LLM filtering/analysis)
OSINT_USE_AI=1
# 1 = do not clear the terminal on CLI startup
# OSINT_NO_CLEAR=1

# ---------- Ollama (local LLM) ----------
OLLAMA_URL=http://localhost:11434/api/generate
OLLAMA_MODEL=qwen2.5:7b
# Lower context = less RAM; useful on 8 GB machines:
OLLAMA_NUM_CTX=4096
# Output-token caps:
# OLLAMA_NUM_PREDICT=1200
# OLLAMA_FILTER_NUM_PREDICT=200
# OLLAMA_ANALYZE_NUM_PREDICT=450
# OLLAMA_KEEP_ALIVE=15m
# Timeouts (seconds):
# OLLAMA_FILTER_TIMEOUT=300
# OLLAMA_ANALYZE_TIMEOUT=420

# ---------- Cloud LLM ----------
# ollama | openai | openrouter
LLM_PROVIDER=ollama
# OPENAI_API_KEY=
# OPENROUTER_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_FILTER_TIMEOUT=120
# OPENAI_ANALYZE_TIMEOUT=180

# ---------- LLM input limits ----------
# OSINT_MAX_FILTER_SITES=20
# OSINT_MAX_ANALYZE_SITES=15
# OSINT_MAX_OBSERVATIONS=15

# ---------- Paths ----------
OSINT_OUTPUT_DIR=./output
OSINT_INVESTIGATIONS_DIR=./investigations
OSINT_SAVED_PAGES_DIR=./saved_pages
# Web-managed LLM settings (may contain an API key; gitignored):
# OSINT_SETTINGS_FILE=./llm_settings.json
# OSINT_LOG_DIR=~/osint_helper/logs
# OSINT_LOG_LEVEL=INFO

# ---------- ThreatFox (optional, domains) ----------
# Free key: https://auth.abuse.ch/
THREATFOX_KEY=
# THREATFOX_URL=https://threatfox-api.abuse.ch/api/v1/

# ---------- External tool paths (optional) ----------
# THEHARVESTER_BIN=/home/user/theHarvester/.venv/bin/theHarvester
# DIABLINDA_BIN=/home/user/.npm-global/bin/diablinda

# ---------- Interface language (CLI + web) ----------
# OSINT_LANG=ru
